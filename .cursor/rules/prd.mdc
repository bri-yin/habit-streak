## 6. State Management

Use a single observable store injected via `@Environment`:

```swift
@Observable
final class HabitStore {
    var modelContext: ModelContext
    var selectedDate: Date = Calendar.current.startOfDay(for: Date())
    var weekStartsOn: WeekStartDay = .sunday

    init(modelContext: ModelContext) {
        self.modelContext = modelContext
        loadPreferences()
    }

    // Habit CRUD
    func addHabit(_ habit: Habit) { ... }
    func updateHabit(_ habit: Habit) { ... }
    func deleteHabit(_ habit: Habit) { ... }
    func archiveHabit(_ habit: Habit) { ... }
    func restoreHabit(_ habit: Habit) { ... }
    func reorderHabits(_ habits: [Habit]) { ... }

    // Completions
    func toggleCompletion(habit: Habit, date: Date) { ... }
    func isCompleted(habit: Habit, date: Date) -> Bool { ... }

    // Derived
    func streak(for habit: Habit) -> Int { ... }
    func completionRate(in range: DateInterval) -> Double { ... }
    func topPerformingHabits(in range: DateInterval) -> [Habit] { ... }

    // Data
    func exportJSON() -> Data { ... }
    func resetToSeedData() { ... }
    func clearAllData() { ... }
}
```

Views query habits via `@Query` for live SwiftData updates. The store handles mutations and derived calculations.

