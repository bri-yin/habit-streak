## 4. Data Model

Using SwiftData:

```swift
import SwiftData
import Foundation

enum FrequencyMode: String, Codable {
    case daily
    case weekly
    case monthly
}

enum WeekDay: Int, Codable, CaseIterable {
    case sunday = 1, monday, tuesday, wednesday, thursday, friday, saturday
}

@Model
final class Habit {
    @Attribute(.unique) var id: UUID
    var name: String
    var emoji: String
    var frequencyRaw: String
    var weekdaysRaw: [Int]      // stored as ints, mapped to WeekDay
    var countPerPeriod: Int     // used for weekly and monthly
    var reminderEnabled: Bool
    var reminderHour: Int?
    var reminderMinute: Int?
    var createdAt: Date
    var archivedAt: Date?
    var order: Int

    @Relationship(deleteRule: .cascade, inverse: \HabitCompletion.habit)
    var completions: [HabitCompletion] = []

    var frequency: FrequencyMode {
        get { FrequencyMode(rawValue: frequencyRaw) ?? .daily }
        set { frequencyRaw = newValue.rawValue }
    }

    var weekdays: [WeekDay] {
        get { weekdaysRaw.compactMap { WeekDay(rawValue: $0) } }
        set { weekdaysRaw = newValue.map { $0.rawValue } }
    }

    init(name: String, emoji: String, frequency: FrequencyMode) {
        self.id = UUID()
        self.name = name
        self.emoji = emoji
        self.frequencyRaw = frequency.rawValue
        self.weekdaysRaw = WeekDay.allCases.map { $0.rawValue }
        self.countPerPeriod = 1
        self.reminderEnabled = false
        self.createdAt = Date()
        self.order = 0
    }
}

@Model
final class HabitCompletion {
    @Attribute(.unique) var id: UUID
    var date: Date              // normalized to start of day
    var completedAt: Date
    var habit: Habit?

    init(date: Date, habit: Habit) {
        self.id = UUID()
        self.date = Calendar.current.startOfDay(for: date)
        self.completedAt = Date()
        self.habit = habit
    }
}
```

### Streak calculation
Pure function in `StreakCalculator.swift`. Takes a `Habit` and returns an `Int`. Rules:

- **Daily habits**: count consecutive scheduled days completed up to today. Skip days where the habit was not scheduled (those don't break or extend the streak).
- **Weekly habits**: count consecutive weeks where completion count met `countPerPeriod`. A week boundary follows the user's preferred week start (Sunday or Monday).
- **Monthly habits**: count consecutive calendar months where completion count met `countPerPeriod`.

Streaks reset to 0 when a period closes without meeting the requirement.

